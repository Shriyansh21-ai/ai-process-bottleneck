# Frontend environment configuration.
#
# ONLY public, browser-safe values belong here. Anything exposed to the browser
# is public — never put backend secrets (OPENAI_API_KEY, DATABASE_URL,
# JWT_SECRET_KEY, DB credentials, ...) in a VITE_* variable.

# Base URL of the backend API (FastAPI). Defaults to http://127.0.0.1:8000
# when unset. In Docker/compose this typically points at the backend service.
VITE_API_URL=http://127.0.0.1:8000
