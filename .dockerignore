# Version control
.git
.gitignore
.github

# Secrets / local env (NEVER bake into the image)
.env
.env.*
!.env.example

# Python caches / build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tests (not needed at runtime; CI runs them outside the image)
tests/
pytest.ini

# Frontend (separate build/deploy)
frontend/

# Local data stores / large datasets / logs
qdrant_data/
data/
logs/
*.log

# IDE / editor / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Docs / misc that aren't needed at runtime
*.md
!Readme.md
