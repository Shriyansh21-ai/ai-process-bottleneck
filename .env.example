# ============================================================
# AI Process Bottleneck — environment configuration template
# ============================================================
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit a real `.env`. Secrets belong here / in your platform's
# secret manager only — never in Dockerfile, docker-compose.yml, source
# code, CI config, or the README.
#
# Legend:  [REQUIRED]  must be set or the app will not start
#          [FALLBACK]  optional; a working fallback is used when absent
#          [OPTIONAL]  tuning knob with a sane default

# ------------------------------------------------------------
# DATABASE  (PostgreSQL)
# ------------------------------------------------------------
# [REQUIRED] These three drive the PostgreSQL container in docker-compose
# and are used to build DATABASE_URL for the app service.
POSTGRES_DB=bottleneck
POSTGRES_USER=bottleneck
POSTGRES_PASSWORD=change_me_use_a_strong_password

# [OPTIONAL] Host port to publish PostgreSQL on for LOCAL access only.
# docker-compose binds this to 127.0.0.1 so it is not exposed publicly.
POSTGRES_PORT=5432

# [REQUIRED] Full SQLAlchemy connection URL used by the application and by
# Alembic. In docker-compose this is OVERRIDDEN automatically to point at the
# `postgres` service, so you can leave it blank when running via compose.
# For running the app directly on your host, set it explicitly, e.g.:
#   postgresql+psycopg2://bottleneck:change_me@localhost:5432/bottleneck
DATABASE_URL=

# ------------------------------------------------------------
# MODEL PROVIDER / LLM ROUTING
# ------------------------------------------------------------
# [OPTIONAL] Preferred generation tier. The LLM router falls back
# automatically: OpenAI (if key present) -> Ollama -> safe offline mode.
DEFAULT_PROVIDER=ollama

# [FALLBACK] Ollama local inference. If Ollama is unreachable the router
# degrades to offline mode; the app keeps serving.
OLLAMA_MODEL=phi3:mini
OLLAMA_BASE_URL=http://localhost:11434

# [FALLBACK] OpenAI generation tier. Leave OPENAI_API_KEY blank to run on
# Ollama / offline fallback. NEVER commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# [OPTIONAL] Per-call wall-clock bound (seconds) for a remote LLM request.
# Guards the planner/verifier LLM calls, which run outside the execution-phase
# timeout, so a hung provider cannot stall a /run indefinitely. Default 60.
LLM_TIMEOUT_SECONDS=60

# [FALLBACK] Tavily web-search tool. Leave TAVILY_API_KEY blank to disable the
# `web_search` tool; the agent pipeline still runs and the tool degrades to a
# controlled "unavailable" result. NEVER commit a real key.
TAVILY_API_KEY=

# ------------------------------------------------------------
# RUNTIME / DEPLOYMENT
# ------------------------------------------------------------
# [OPTIONAL] Deployment environment: dev | staging | production
# (ENVIRONMENT is accepted as an alias for ENV.)
ENV=dev

# [OPTIONAL] CORS allow-list. Comma-separated origins, or "*" (default) to
# allow any origin. In production set an explicit list, e.g.
#   CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
# Credentials are auto-enabled only when this is an explicit list (not "*").
CORS_ALLOW_ORIGINS=*

# ------------------------------------------------------------
# AUTHENTICATION / JWT  (Milestone 6)
# ------------------------------------------------------------
# [REQUIRED in production] Secret used to sign JWT access tokens. There is NO
# production default — the app refuses to start in production without it. In
# dev/staging a well-known INSECURE fallback is used. Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# [OPTIONAL] JWT signing algorithm (default HS256).
JWT_ALGORITHM=HS256

# [OPTIONAL] Access-token lifetime in minutes (default 60).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------
# RATE LIMITING  (Milestone 6)
# ------------------------------------------------------------
# [OPTIONAL] Master switch. Set to false to disable all rate limiting
# (local dev / tests). Default: enabled.
RATE_LIMIT_ENABLED=true

# [OPTIONAL] slowapi limit strings. Applied to auth endpoints and /run.
AUTH_RATE_LIMIT=10/minute
RUN_RATE_LIMIT=30/minute

# [OPTIONAL] ASGI server tuning (consumed by entrypoint.sh in the container).
# Keep workers at 1: each worker loads its own embedding model (~hundreds of
# MB). Scale out with container replicas, not workers.
WEB_CONCURRENCY=1
APP_HOST=0.0.0.0
APP_PORT=8000

# [OPTIONAL] Startup migration controls (entrypoint.sh).
#   RUN_MIGRATIONS=1  run `alembic upgrade head` before serving (default)
#   DB_WAIT_TIMEOUT   seconds to wait for PostgreSQL before failing startup
RUN_MIGRATIONS=1
DB_WAIT_TIMEOUT=60

# ------------------------------------------------------------
# OBSERVABILITY / LOGGING  (Milestone 8)
# ------------------------------------------------------------
# [OPTIONAL] Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# ------------------------------------------------------------
# REVERSE PROXY  (Milestone 8)
# ------------------------------------------------------------
# [OPTIONAL] Which upstream peers may set X-Forwarded-For/-Proto (consumed by
# entrypoint.sh). Default is loopback so clients cannot spoof their IP (this
# keeps rate-limit keying and logged IPs honest). Set to your reverse proxy's
# IP/CIDR when deploying behind one; only use "*" if a trusted proxy is the
# guaranteed sole ingress.
FORWARDED_ALLOW_IPS=127.0.0.1

# ------------------------------------------------------------
# RESOURCE LIMITS  (Milestone 8)
# ------------------------------------------------------------
# [OPTIONAL] Max accepted request body size in bytes (default 1 MiB).
MAX_REQUEST_BYTES=1048576

# [OPTIONAL] Agent execution safeguards.
#   TOOL_TIMEOUT_SECONDS       per (async) tool call timeout (default 60)
#   EXECUTION_TIMEOUT_SECONDS  wall-clock bound for one execution phase (300)
#   MAX_PLAN_STEPS             reject plans with more steps than this (50)
#   MAX_PARALLEL_STEPS         max steps run concurrently per wave (8)
TOOL_TIMEOUT_SECONDS=60
EXECUTION_TIMEOUT_SECONDS=300
MAX_PLAN_STEPS=50
MAX_PARALLEL_STEPS=8

# ------------------------------------------------------------
# DATABASE POOL / TIMEOUTS  (Milestone 8)
# ------------------------------------------------------------
# [OPTIONAL] SQLAlchemy connection-pool tuning + PostgreSQL statement timeout.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=30000
